# Until @shieldlabs/js is published, npm cannot resolve the peer dependency from the registry.
# legacy-peer-deps: npm install and npm ci do not try to install peer dependencies.
# save-dev: npm install --no-save <tarball> puts @shieldlabs/js into node_modules anyway.
# See CONTRIBUTING.md. Remove this file after @shieldlabs/js 1.0.0 is on npm.
legacy-peer-deps=true
save-dev=true
