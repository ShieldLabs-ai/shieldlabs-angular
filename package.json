{
  "name": "@shieldlabs-ai/angular",
  "version": "1.0.0",
  "description": "Angular bindings for ShieldLabs device intelligence: a provider that loads the agent once, signals for its state and an identify helper that returns a request ID for your backend.",
  "keywords": [
    "shieldlabs",
    "angular",
    "signals",
    "device-intelligence",
    "fraud-detection",
    "risk-score",
    "identification"
  ],
  "homepage": "https://docs.shieldlabs.ai",
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-angular/issues",
    "email": "contact@shieldlabs.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-angular.git"
  },
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "node scripts/audit.mjs",
    "use-angular": "node scripts/use-angular.mjs",
    "prepublishOnly": "node scripts/refuse-root-publish.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@shieldlabs-ai/js": "^1.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/animations": "~17.3.12",
    "@angular/common": "~17.3.12",
    "@angular/compiler": "~17.3.12",
    "@angular/compiler-cli": "~17.3.12",
    "@angular/core": "~17.3.12",
    "@angular/platform-browser": "~17.3.12",
    "@angular/platform-browser-dynamic": "~17.3.12",
    "@angular/platform-server": "~17.3.12",
    "@eslint/js": "~9.39.0",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "~9.39.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "~17.3.0",
    "rxjs": "~7.8.1",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.46.0",
    "vite": "~6.4.1",
    "vitest": "~4.1.11",
    "zone.js": "~0.14.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "tar": "^7.5.22"
  }
}
